BIND_IP=127.0.0.1
MC_PORT=25565
# Accepter explicitement https://www.minecraft.net/eula avant TRUE.
MC_EULA=FALSE
MC_IMAGE_TAG=java21
MC_VERSION=1.21.11
MC_TYPE=VANILLA
# Pour reutiliser un JAR existant : MC_TYPE=CUSTOM et chemin dans le conteneur.
MC_CUSTOM_SERVER=
MC_MEMORY=2G
# FALSE : mode hors ligne, sans verification des comptes Microsoft/Mojang.
MC_ONLINE_MODE=FALSE
MC_LEVEL=world
# Vide = volume Docker ; import possible via un dossier absolu contenant le serveur.
MC_DATA_PATH=
MC_MAX_PLAYERS=10
# Distances en chunks : affichage envoye aux joueurs et simulation du monde.
MC_VIEW_DISTANCE=10
MC_SIMULATION_DISTANCE=10
TZ=Europe/Paris
